menu "ESP32-S3 MPU6050 Motion Configuration"

    config MPU6050_I2C_SDA
        int "I2C SDA GPIO"
        default 10
        help
            GPIO number for I2C SDA. Avoid GPIO26-37 on ESP32-S3 N16R8 (Octal PSRAM).

    config MPU6050_I2C_SCL
        int "I2C SCL GPIO"
        default 11
        help
            GPIO number for I2C SCL. Avoid GPIO26-37 on ESP32-S3 N16R8 (Octal PSRAM).

    config MPU6050_I2C_FREQ_HZ
        int "I2C Clock Frequency (Hz)"
        default 400000
        range 100000 400000

    config MPU6050_I2C_ADDR
        hex "MPU6050 I2C Address"
        default 0x68
        help
            0x68 when AD0 is LOW (GND), 0x69 when AD0 is HIGH (3.3V).

endmenu
